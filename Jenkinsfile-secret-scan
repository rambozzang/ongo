// onGo - 정기 시크릿 스캔 (히스토리 전체)
//
// 왜 별도 파이프라인인가:
//   Jenkinsfile-backend 의 Repository Security Check 는 `git ls-files` 로 현재 트리만 본다.
//   빠르지만 **이미 커밋된 이력은 잡지 못한다.** 실제로 ongo_backup_20260218.sql /
//   ongo_backup_20260223.sql 이 히스토리에 남아 있는데도 그 검사는 계속 통과해왔다.
//   반대로 매 빌드마다 히스토리 전체를 스캔하면 배포가 느려진다.
//   그래서 빠른 트리 검사(매 빌드) + 전체 히스토리 스캔(정기) 2단계로 나눈다.
//
// Jenkins 설정 방법:
//   새 Pipeline 잡을 만들고 이 파일을 Jenkinsfile 로 지정한다.
//   Docker 실행 권한이 있는 에이전트가 필요하다(gitleaks 를 컨테이너로 돌린다).
//
// 최초 1회는 수동 실행해 기존 히스토리의 노출 범위를 확정하는 데 쓴다.

pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
    }

    triggers {
        // 매일 새벽. H 는 젠킨스가 부하를 분산시키도록 시간을 흩뿌리는 값이다.
        cron('H 4 * * *')
    }

    environment {
        GITLEAKS_IMAGE = 'zricethezav/gitleaks:latest'
        REPORT = 'gitleaks-report.json'
    }

    stages {
        stage('Fetch Full History') {
            steps {
                // Jenkins 기본 체크아웃은 shallow 일 수 있다. 히스토리 스캔이 목적이므로 전체를 받는다.
                sh '''
                    if [ -f .git/shallow ]; then
                        echo "shallow clone 감지 — 전체 히스토리를 받습니다"
                        git fetch --unshallow --tags
                    else
                        git fetch --tags
                    fi
                    echo "커밋 수: $(git rev-list --all --count)"
                '''
            }
        }

        stage('Full History Secret Scan') {
            steps {
                script {
                    // gitleaks 는 시크릿을 발견하면 exit 1 이다. 리포트를 남겨야 하므로 코드를 받아 처리한다.
                    // --redact 로 실제 값이 젠킨스 로그에 찍히지 않게 한다.
                    def code = sh(
                        script: """
                            docker run --rm -v "\$PWD:/repo" -w /repo ${GITLEAKS_IMAGE} \
                                detect --source=/repo --redact --no-banner \
                                --report-format=json --report-path=/repo/${REPORT}
                        """,
                        returnStatus: true,
                    )
                    env.LEAK_EXIT = "${code}"
                    echo "gitleaks exit=${code} (0=클린, 1=발견, 그 외=실행 오류)"
                }
            }
        }

        stage('Report') {
            steps {
                script {
                    if (fileExists(env.REPORT)) {
                        archiveArtifacts artifacts: env.REPORT, allowEmptyArchive: true
                        def count = sh(
                            script: "grep -o '\"RuleID\"' ${REPORT} | wc -l || echo 0",
                            returnStdout: true,
                        ).trim()
                        echo "발견된 시크릿 후보: ${count}건 (리포트는 아티팩트로 보관)"
                    }

                    if (env.LEAK_EXIT != '0' && env.LEAK_EXIT != '1') {
                        error "gitleaks 실행에 실패했습니다 (exit=${env.LEAK_EXIT}). Docker 권한과 이미지 접근을 확인하세요."
                    }

                    if (env.LEAK_EXIT == '1') {
                        // 히스토리에 남은 것은 이 빌드로 고칠 수 없다. 배포를 막는 대신 unstable 로 표시해
                        // 사람이 판단하게 한다(자격증명 회전 → 저장소 가시성 → 히스토리 정리 순).
                        unstable('히스토리에서 시크릿 후보가 발견되었습니다. 아티팩트 리포트를 확인하세요.')
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo '히스토리 시크릿 스캔 통과.'
        }
        unstable {
            echo '시크릿 후보 발견 — 리포트 확인 후 대응 순서를 따르세요.'
        }
    }
}
