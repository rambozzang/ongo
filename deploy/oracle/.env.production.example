# OnGo Production Environment Template
# Copy this file to .env.production and fill in all values
# NEVER commit the actual .env.production file to Git

# Database
DB_USERNAME=ongo
DB_PASSWORD=

# JWT (must be at least 32 bytes)
JWT_SECRET=

# Platform token encryption (Base64 encoded, 32 bytes)
PLATFORM_TOKEN_ENCRYPTION_KEY=

# AI APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Storage (Cloudflare R2)
R2_BUCKET=ongo-videos
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Payment
TOSS_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=production

# CORS
CORS_ALLOWED_ORIGINS=https://ongo.codelabtiger.com

# Platform APIs
GOOGLE_API_KEY=

# Feature flags
GEMINI_ENABLED=false
GEMINI_PROJECT_ID=
GEMINI_LOCATION=us-central1
