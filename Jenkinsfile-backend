// onGo - Backend Jenkins Pipeline
// Git push시 자동으로 백엔드 빌드 + 배포

pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

     triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'changed_files', value: '$.commits[*].["modified","added","removed"][*]']
            ],
            regexpFilterText: '$changed_files',
            regexpFilterExpression: '.*(backend)/.*',  // backend/ 변경 시 트리거
            token: '${JENKINS_WEBHOOK_TOKEN_BACKEND}'
        )
    }

    stages {
        // 1단계: 매 빌드마다 도는 빠른 트리 검사.
        //
        // 이건 "현재 트리에 덤프가 들어왔는가"만 본다. git ls-files 는 HEAD 만 보므로
        // **이미 커밋된 이력은 잡지 못한다.** 실제로 ongo_backup_*.sql 이 히스토리에
        // 남아 있는데도 이 검사는 계속 통과해왔다.
        // 히스토리 전체 스캔은 Jenkinsfile-secret-scan 의 정기 작업이 담당한다.
        stage('Repository Security Check') {
            steps {
                script {
                    def sensitiveFiles = sh(
                        script: "git ls-files | grep -E '(^|/)([^/]*(backup|dump)[^/]*\\.(sql|dump|bak))\$' || true",
                        returnStdout: true,
                    ).trim()
                    if (sensitiveFiles) {
                        error "Tracked database export detected:\n${sensitiveFiles}"
                    }

                    // 재발 방지 규칙이 제거되면 즉시 알아채도록 .gitignore 가드를 확인한다.
                    def ignoreGuard = sh(
                        script: "grep -qE '^\\*\\.sql\$' .gitignore && echo ok || true",
                        returnStdout: true,
                    ).trim()
                    if (ignoreGuard != 'ok') {
                        error '.gitignore 의 *.sql 차단 규칙이 사라졌습니다. DB 덤프 재유입을 막는 가드입니다.'
                    }
                }
            }
        }

        stage('No WIP Runtime Surface') {
            steps {
                script {
                    def wipSources = sh(
                        script: "grep -R -l -E '^[[:space:]]*@Profile[(]\"wip\"[)]' backend --include='*.kt' || true",
                        returnStdout: true,
                    ).trim()
                    if (wipSources) {
                        error "@Profile(\\\"wip\\\") must not reach the runtime tree:\n${wipSources}"
                    }
                }
            }
        }

        stage('No Disabled Runtime Surface') {
            steps {
                script {
                    def disabledSources = sh(
                        script: "grep -R -l -E '^[[:space:]]*@Profile[(]\\\"disabled\\\"[)]' backend/onGo-api/src/main backend/onGo-application/src/main --include='*.kt' || true",
                        returnStdout: true,
                    ).trim()
                    if (disabledSources) {
                        error "@Profile(\\\"disabled\\\") must not reach the runtime tree:\n${disabledSources}"
                    }
                }
            }
        }

        stage('Build Backend') {
            steps {
                dir('backend') {
                    // 배포 노드는 Docker를 사용하지 않는다. Testcontainers *IT는 로컬 또는
                    // Docker가 제공되는 별도 통합 테스트 잡에서 실행하고, 여기서는 단위 테스트와
                    // 패키징만 검증한다.
                    sh './gradlew :onGo-common:test :onGo-domain:test :onGo-application:test :onGo-infrastructure:test :onGo-api:test :onGo-api:bootJar --no-daemon -PskipIntegrationTests=true'
                    sh './gradlew jacocoRootReport --no-daemon -PskipIntegrationTests=true'
                    sh './gradlew jacocoRootCoverageVerification --no-daemon -PskipIntegrationTests=true'
                }
            }
        }

        stage('Deploy Backend') {
            steps {
                script {
                    echo 'Syncing backend workspace to production source directory...'
                    sh 'mkdir -p /data/ongo/src/backend /data/ongo/src/deploy'

                    // backend, deploy 폴더만 동기화하여 프론트엔드 결과물 보존
                    sh 'rsync -av --delete --exclude=".git" backend/ /data/ongo/src/backend/'
                    sh 'rsync -av --delete --exclude=".git" deploy/ /data/ongo/src/deploy/'

                    echo 'Executing deployment script for backend...'
                    sh 'JENKINS_NODE_COOKIE=dontKillMe bash /data/ongo/src/deploy/deploy.sh backend --skip-git --skip-build'
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }

        success {
            echo 'Backend build and deploy completed successfully!'
        }

        failure {
            echo 'Backend build or deploy failed!'
        }
    }
}
